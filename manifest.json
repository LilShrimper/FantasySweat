{
  "manifest_version": 3,
  "name": "Fantasy Sweat",
  "version": "1.0.0",
  "description": "Pulls your fantasy football matchups and tells you who to cheer for and who to root against, game by game.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fantasy Sweat",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.sleeper.app/*",
    "https://api.sleeper.com/*",
    "https://sleeper.com/*",
    "https://site.api.espn.com/*"
  ]
}
